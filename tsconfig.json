{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "tests/client/**/*.ts",
    "tests/client/**/*.tsx",
    "tsdown.config.ts",
    "vitest.config.ts"
  ]
}
